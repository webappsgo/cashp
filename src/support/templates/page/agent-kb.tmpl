{{ define "content" }}
  {{ $d := .Data }}
  <div class="support-card">
    <h2>{{ if $d.Editing }}Edit article{{ else }}New article{{ end }}</h2>
    <form class="form support-form" method="post"
      action="{{ if $d.Editing }}{{ .BasePath }}/agents/articles/{{ $d.Article.ID }}{{ else }}{{ .BasePath }}/agents/articles{{ end }}">
      <input type="hidden" name="csrf_token" value="{{ .CSRF }}">
      <div class="form-group">
        <label class="form-label" for="article-title">Title</label>
        <input class="form-input" id="article-title" name="title" type="text" required maxlength="200"
          value="{{ $d.Article.Title }}">
      </div>
      <div class="form-group">
        <label class="form-label" for="article-slug">Address</label>
        <input class="form-input" id="article-slug" name="slug" type="text" maxlength="120"
          value="{{ $d.Article.Slug }}">
      </div>
      <div class="form-group">
        <label class="form-label" for="article-tags">Tags</label>
        <input class="form-input" id="article-tags" name="tags" type="text" maxlength="300"
          value="{{ $d.Article.Tags }}">
      </div>
      <div class="form-group">
        <label class="form-label" for="article-body">Body</label>
        <textarea class="form-textarea" id="article-body" name="body" rows="16" required
          maxlength="200000">{{ $d.Article.Body }}</textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
    </form>

    {{ if $d.Editing }}
      <form class="form support-inline-form" method="post"
        action="{{ .BasePath }}/agents/articles/{{ $d.Article.ID }}/status">
        <input type="hidden" name="csrf_token" value="{{ .CSRF }}">
        <div class="form-group">
          <label class="form-label" for="article-status">Move to</label>
          <select class="form-input" id="article-status" name="status" required>
            {{ range $d.Statuses }}
              <option value="{{ . }}">{{ . }}</option>
            {{ end }}
          </select>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-secondary">Apply</button>
        </div>
      </form>
      {{ if not $d.CanPub }}
        <p>Publishing is done by an administrator. Submit the article for review instead.</p>
      {{ end }}
    {{ end }}
  </div>

  <div class="support-card">
    <h2>All articles</h2>
    <ul class="support-list">
      {{ range $d.Articles }}
        <li>
          <a href="{{ $.BasePath }}/agents/articles/{{ .ID }}/edit">{{ .Title }}</a>
          <span class="badge badge-muted">{{ .Status }}</span>
        </li>
      {{ else }}
        <li class="support-empty">No articles yet.</li>
      {{ end }}
    </ul>
    {{ template "support_pagination" $d }}
  </div>

  <div class="support-card">
    <h2>Your canned responses</h2>
    <ul class="support-list">
      {{ range $d.Canned }}
        <li>
          <strong>{{ .Title }}</strong>
          <span class="badge badge-muted">{{ .Scope }}</span>
          <span class="badge badge-info">used {{ .UsageCount }}</span>
          {{ if eq .Scope "PERSONAL" }}
            <form class="support-inline-form" method="post"
              action="{{ $.BasePath }}/agents/canned-responses/{{ .ID }}/delete">
              <input type="hidden" name="csrf_token" value="{{ $.CSRF }}">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          {{ end }}
        </li>
      {{ else }}
        <li class="support-empty">None are visible to you yet.</li>
      {{ end }}
    </ul>

    <form class="form support-form" method="post" action="{{ .BasePath }}/agents/canned-responses">
      <input type="hidden" name="csrf_token" value="{{ .CSRF }}">
      <div class="form-group">
        <label class="form-label" for="canned-title">Title</label>
        <input class="form-input" id="canned-title" name="title" type="text" required maxlength="120">
      </div>
      <div class="form-group">
        <label class="form-label" for="canned-tags">Tags</label>
        <input class="form-input" id="canned-tags" name="tags" type="text" maxlength="300">
      </div>
      <div class="form-group">
        <label class="form-label" for="canned-body">Body</label>
        <textarea class="form-textarea" id="canned-body" name="body" rows="6" required maxlength="8000"></textarea>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary">Save personal response</button>
      </div>
    </form>
  </div>
{{ end }}
