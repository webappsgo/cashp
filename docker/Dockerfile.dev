# Development image - same as the release image but the binary runs in debug mode
# Image name: ghcr.io/webappsgo/cashp:devel
# Build: docker build -t ghcr.io/webappsgo/cashp:devel -f docker/Dockerfile.dev .

# =============================================================================
# Build Stage - Compile Go binary
# =============================================================================
FROM casjaysdev/go:latest AS builder

# Install git and bash (git: required for go mod download; bash: for build scripts)
RUN apk add --no-cache git bash

ARG TARGETARCH
ARG VERSION=devel
ARG BUILD_DATE
ARG BUILD_EPOCH
ARG COMMIT_ID
# Optional: set via --build-arg OFFICIAL_SITE=... (empty by default)
ARG OFFICIAL_SITE

WORKDIR /app

# Copy go.mod first for layer caching
COPY go.mod go.sum ./
RUN go mod download

# Copy source and build (debug build keeps symbols - no -s -w strip flags)
COPY . .
RUN CGO_ENABLED=0 GOOS=linux GOARCH=${TARGETARCH} go build -trimpath \
    -ldflags "-X 'main.Version=${VERSION}' -X 'main.CommitID=${COMMIT_ID}' -X 'main.BuildEpoch=${BUILD_EPOCH}' -X 'main.OfficialSite=${OFFICIAL_SITE}'" \
    -o /app/binary/cashp ./src

# =============================================================================
# Runtime Stage - Alpine with debugging tooling
# =============================================================================
FROM alpine:latest

ARG VERSION=devel
ARG BUILD_DATE
ARG BUILD_EPOCH
ARG COMMIT_ID
ARG LICENSE=MIT

# No LABEL blocks — all image metadata is applied as OCI annotations at build time.

# Install runtime packages plus debug tooling (jq/bind-tools/netcat/procps/strace/tcpdump)
# NOTE: Tor binary installed but NOT configured here - binary handles all Tor setup
RUN apk add --no-cache \
    git \
    curl \
    bash \
    tini \
    tor \
    jq \
    less \
    bind-tools \
    netcat-openbsd \
    procps \
    strace \
    tcpdump

# NO directory creation - binary handles ALL setup based on env vars

# Copy binary from builder stage (multi-stage build)
COPY --from=builder /app/binary/cashp /usr/local/bin/cashp

# Copy BUILD-TIME overlay (entrypoint.sh) from docker/rootfs/ into image
COPY docker/rootfs/ /

# Copy Dockerfile to image (for reference and backup)
COPY docker/Dockerfile.dev /root/Dockerfile

# Make all binaries/scripts in /usr/local/bin executable (755)
RUN chmod 755 /usr/local/bin/*

# Set environment
# The devel image runs the binary in debug mode - this is what separates it from :latest
ENV TZ=America/New_York \
    DATABASE_DIR=/data/db/sqlite \
    MODE=development \
    DEBUG=true

# Expose internal port (always 80)
EXPOSE 80

# Stop signal for graceful shutdown
STOPSIGNAL SIGRTMIN+3

# Health check (long start period for services that need initialization)
HEALTHCHECK --start-period=10m --interval=5m --timeout=15s --retries=3 \
    CMD /usr/local/bin/cashp --status || exit 1

# Use tini as init with signal propagation
# -p SIGTERM: propagate SIGTERM to child processes
ENTRYPOINT [ "tini", "-p", "SIGTERM", "--", "/usr/local/bin/entrypoint.sh" ]
