{{ define "content" }}
<section class="card panel-auth-card">
  {{ template "form_error" .Data.Error }}
  <p class="form-hint">Enter the six-digit code from your authenticator, or one of your recovery codes.</p>
  <form class="form" method="post" action="{{ .Base }}" autocomplete="off">
    {{ template "csrf" . }}
    <input type="hidden" name="action" value="verify">

    <div class="form-group">
      <label class="form-label" for="field-code">Verification code</label>
      <input class="form-input" id="field-code" name="code" type="text" inputmode="numeric" autocomplete="one-time-code" spellcheck="false" autocapitalize="none" required autofocus>
    </div>

    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Verify</button>
      <a class="btn btn-secondary" href="{{ .Base }}">Start over</a>
    </div>
  </form>
  <p class="form-hint">This challenge expires at {{ formatTime .Data.Expires }}.</p>
</section>
{{ end }}
