{{define "content" -}}
<section class="card narrow">
  <form method="post" action="{{.BasePath}}/password/forgot" class="stack">
    {{template "csrf" .}}
    <div class="field">
      <label for="email">Email address</label>
      <input id="email" name="email" type="email" autocomplete="email" autocapitalize="none"
             spellcheck="false" required autofocus aria-describedby="reset-hint">
      <p class="hint" id="reset-hint">If an account uses this address, a reset link will be sent. The
        response is the same either way, so nobody can use this form to discover who has an account.</p>
    </div>
    <button type="submit" class="btn btn-primary">Send reset link</button>
  </form>
  <ul class="linkrow">
    <li><a href="{{.BasePath}}/login">Back to sign in</a></li>
  </ul>
</section>
{{- end}}
