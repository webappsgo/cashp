{{define "content" -}}
<section class="card narrow">
  <form method="post" action="{{.BasePath}}/password/reset" class="stack">
    {{template "csrf" .}}
    <input type="hidden" name="code" value="{{.Next}}">
    <div class="field">
      <label for="password">New password</label>
      <input id="password" name="password" type="password" autocomplete="new-password"
             minlength="12" required autofocus aria-describedby="password-hint">
      <p class="hint" id="password-hint">At least 12 characters. Every other session will be signed out.</p>
    </div>
    <div class="field">
      <label for="confirm">Confirm new password</label>
      <input id="confirm" name="password_confirm" type="password" autocomplete="new-password"
             minlength="12" required>
    </div>
    <button type="submit" class="btn btn-primary">Set new password</button>
  </form>
</section>
{{- end}}
