{{define "content" -}}
<nav class="tabs" aria-label="Organization sections">
  <ul>
    <li><a href="#members">Members</a></li>
    <li><a href="#invites">Invitations</a></li>
    <li><a href="#tokens">API tokens</a></li>
    <li><a href="#settings">Settings</a></li>
  </ul>
</nav>

<section class="card">
  <h2>{{.Org.Name}}</h2>
  <dl class="facts">
    <dt>Handle</dt><dd>{{.Org.Slug}}</dd>
    <dt>Visibility</dt><dd>{{title .Org.Visibility}}</dd>
    <dt>Members</dt><dd>{{.Org.MemberCount}}</dd>
    <dt>Your role</dt><dd>{{title .Org.YourRole}}</dd>
    <dt>Created</dt><dd>{{date .Org.CreatedAt}}</dd>
  </dl>
  <p><a href="{{.BasePath}}/orgs/{{.Org.Slug}}/domains">Custom domains for this organization</a></p>
</section>

<section class="card" id="members">
  <h2>Members</h2>
  <div class="tablewrap">
    <table>
      <caption class="sr-only">Members of {{.Org.Name}}</caption>
      <thead>
        <tr><th scope="col">Member</th><th scope="col">Role</th><th scope="col">Joined</th><th scope="col">Actions</th></tr>
      </thead>
      <tbody>
        {{range .Members}}
        <tr>
          <td>{{.Username}}</td>
          <td>{{title .Role}}</td>
          <td>{{date .JoinedAt}}</td>
          <td class="actions">
            <form method="post" action="{{$.BasePath}}/orgs/{{$.Org.Slug}}/members/{{.UserID}}/role" class="inline">
              {{template "csrf" $}}
              <label class="sr-only" for="role-{{.UserID}}">Role for {{.Username}}</label>
              <select id="role-{{.UserID}}" name="role">
                <option value="member" {{if eqs .Role "member"}}selected{{end}}>Member</option>
                <option value="admin" {{if eqs .Role "admin"}}selected{{end}}>Admin</option>
                <option value="owner" {{if eqs .Role "owner"}}selected{{end}}>Owner</option>
              </select>
              <button type="submit" class="btn btn-sm">Apply</button>
            </form>
            <form method="post" action="{{$.BasePath}}/orgs/{{$.Org.Slug}}/members/{{.UserID}}/remove" class="inline">
              {{template "csrf" $}}
              <button type="submit" class="btn btn-danger btn-sm">Remove</button>
            </form>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  <form method="post" action="{{.BasePath}}/orgs/{{.Org.Slug}}/members" class="stack">
    {{template "csrf" .}}
    <div class="field">
      <label for="add_username">Add an existing user by username</label>
      <input id="add_username" name="username" type="text" autocapitalize="none" spellcheck="false" required>
    </div>
    <div class="field">
      <label for="add_role">Role</label>
      <select id="add_role" name="role">
        <option value="member">Member</option>
        <option value="admin">Admin</option>
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Add member</button>
  </form>
</section>

<section class="card" id="invites">
  <h2>Invitations</h2>
  {{if .NewInvite}}
  <p class="alert alert-ok" role="status">
    Send this invitation code to the person you invited. It is shown once.<br>
    <code class="mono wrap">{{.NewInvite}}</code>
  </p>
  {{end}}
  {{if .Invites}}
  <div class="tablewrap">
    <table>
      <caption class="sr-only">Outstanding invitations</caption>
      <thead>
        <tr><th scope="col">Email</th><th scope="col">Role</th><th scope="col">Uses</th><th scope="col">Expires</th><th scope="col">Action</th></tr>
      </thead>
      <tbody>
        {{range .Invites}}
        <tr>
          <td>{{fallbackText .Email}}</td>
          <td>{{title .Role}}</td>
          <td>{{.UseCount}} of {{.MaxUses}}</td>
          <td>{{date .ExpiresAt}}</td>
          <td>
            <form method="post" action="{{$.BasePath}}/orgs/{{$.Org.Slug}}/invites/{{.ID}}/revoke" class="inline">
              {{template "csrf" $}}
              <button type="submit" class="btn btn-danger btn-sm">Revoke</button>
            </form>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="muted">No outstanding invitations.</p>
  {{end}}
  <form method="post" action="{{.BasePath}}/orgs/{{.Org.Slug}}/invites" class="stack">
    {{template "csrf" .}}
    <div class="field">
      <label for="invite_email">Email address</label>
      <input id="invite_email" name="email" type="email" autocapitalize="none" spellcheck="false" required>
    </div>
    <div class="field">
      <label for="invite_role">Role</label>
      <select id="invite_role" name="role">
        <option value="member">Member</option>
        <option value="admin">Admin</option>
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Send invitation</button>
  </form>
</section>

<section class="card" id="tokens">
  <h2>Organization API tokens</h2>
  {{if .NewToken}}
  <p class="alert alert-ok" role="status">
    Copy this token now. It is shown once and cannot be retrieved again.<br>
    <code class="mono wrap">{{.NewToken}}</code>
  </p>
  {{end}}
  {{if .Tokens}}
  <div class="tablewrap">
    <table>
      <caption class="sr-only">API tokens issued for this organization</caption>
      <thead>
        <tr><th scope="col">Name</th><th scope="col">Prefix</th><th scope="col">Scopes</th><th scope="col">Last used</th><th scope="col">Action</th></tr>
      </thead>
      <tbody>
        {{range .Tokens}}
        <tr>
          <td>{{.Name}}</td>
          <td><code class="mono">{{.TokenPrefix}}</code></td>
          <td>{{join ", " .Scopes}}</td>
          <td>{{date .LastUsedAt}}</td>
          <td>
            <form method="post" action="{{$.BasePath}}/orgs/{{$.Org.Slug}}/tokens/{{.ID}}/revoke" class="inline">
              {{template "csrf" $}}
              <button type="submit" class="btn btn-danger btn-sm">Revoke</button>
            </form>
          </td>
        </tr>
        {{end}}
      </tbody>
    </table>
  </div>
  {{else}}
  <p class="muted">No organization tokens yet.</p>
  {{end}}
  <form method="post" action="{{.BasePath}}/orgs/{{.Org.Slug}}/tokens" class="stack">
    {{template "csrf" .}}
    <div class="field">
      <label for="org_token_name">Token name</label>
      <input id="org_token_name" name="name" type="text" maxlength="64" required>
    </div>
    <fieldset class="field">
      <legend>Scopes</legend>
      <label class="check"><input type="checkbox" name="scopes" value="read" checked><span>Read</span></label>
      <label class="check"><input type="checkbox" name="scopes" value="write"><span>Write</span></label>
    </fieldset>
    <div class="field">
      <label for="org_token_expires">Expires in days <span class="hint">(0 means no expiry)</span></label>
      <input id="org_token_expires" name="expires_in_days" type="number" min="0" max="3650" value="90">
    </div>
    <button type="submit" class="btn btn-primary">Create token</button>
  </form>
</section>

<section class="card" id="settings">
  <h2>Settings</h2>
  <form method="post" action="{{.BasePath}}/orgs/{{.Org.Slug}}/settings" class="stack">
    {{template "csrf" .}}
    <div class="field">
      <label for="org_name">Display name</label>
      <input id="org_name" name="name" type="text" maxlength="64" value="{{.Org.Name}}" required>
    </div>
    <div class="field">
      <label for="org_description">Description</label>
      <textarea id="org_description" name="description" rows="3" maxlength="500">{{.Org.Description}}</textarea>
    </div>
    <div class="field">
      <label for="org_website">Website</label>
      <input id="org_website" name="website" type="url" inputmode="url" value="{{.Org.Website}}">
    </div>
    <div class="field">
      <label for="org_location">Location</label>
      <input id="org_location" name="location" type="text" maxlength="64" value="{{.Org.Location}}">
    </div>
    <div class="field">
      <label for="org_visibility">Visibility</label>
      <select id="org_visibility" name="visibility">
        <option value="public" {{if eqs .Org.Visibility "public"}}selected{{end}}>Public</option>
        <option value="private" {{if eqs .Org.Visibility "private"}}selected{{end}}>Private</option>
      </select>
    </div>
    <button type="submit" class="btn btn-primary">Save settings</button>
  </form>

  <div class="danger">
    <h3>Transfer ownership</h3>
    <form method="post" action="{{.BasePath}}/orgs/{{.Org.Slug}}/transfer" class="stack">
      {{template "csrf" .}}
      <div class="field">
        <label for="transfer_to">New owner user ID</label>
        <input id="transfer_to" name="user_id" type="number" min="1" required>
      </div>
      <button type="submit" class="btn btn-danger">Transfer ownership</button>
    </form>

    <h3>Delete organization</h3>
    <form method="post" action="{{.BasePath}}/orgs/{{.Org.Slug}}/delete" class="stack">
      {{template "csrf" .}}
      <div class="field">
        <label for="confirm_slug">Type <strong>{{.Org.Slug}}</strong> to confirm</label>
        <input id="confirm_slug" name="confirm" type="text" autocapitalize="none" spellcheck="false" required>
      </div>
      <button type="submit" class="btn btn-danger">Delete this organization</button>
    </form>
  </div>
</section>
{{- end}}
